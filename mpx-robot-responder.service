[Unit]
Description=MPX Robot Responder — bridges robot messages to OpenClaw agent
Documentation=https://github.com/openclaw/mpx-server
After=network.target mpx-host-listener.service
BindsTo=mpx-host-listener.service

[Service]
Type=simple
User=mangdang
WorkingDirectory=/home/mangdang/mpx-server
Environment=HOST_LISTENER_URL=http://127.0.0.1:19090
Environment=GATEWAY_HOOK_URL=http://127.0.0.1:18789/hooks/agent
Environment=POLL_INTERVAL=1.0
Environment=HOOK_REQUEST_TIMEOUT=30.0
ExecStart=/usr/bin/python3 /home/mangdang/mpx-server/robot-responder.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
